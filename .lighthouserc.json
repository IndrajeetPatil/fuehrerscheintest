{
  "ci": {
    "collect": {
      "//": "Serve the GitHub Pages build under its /fuehrerscheintest/ base path, as deployed. Lighthouse's default mobile throttling applies; assert the median of five runs so CI neither passes on one lucky sample nor fails on one or two slow ones.",
      "startServerCommand": "PAGES_BASE=/fuehrerscheintest/ vp preview --port 5189",
      "startServerReadyPattern": "Local",
      "url": ["http://127.0.0.1:5189/fuehrerscheintest/"],
      "numberOfRuns": 5
    },
    "assert": {
      "aggregationMethod": "median",
      "includePassedAssertions": true,
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:agentic-browsing": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }]
      }
    },
    "upload": {
      "target": "filesystem"
    }
  }
}
